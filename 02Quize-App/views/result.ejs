<%- include('partials/header') %>

<h1 class="text-2xl font-bold text-center mb-6 capitalize"><%= topic %> Quiz Results</h1>
<p class="text-center text-lg mb-6">
  You scored <span class="font-semibold"><%= score %></span> out of <%= total %>
</p>

<div class="space-y-6">
  <% results.forEach((item, index) => { %>
    <div class="bg-white p-4 rounded shadow">
      <p class="font-medium mb-2">Q<%= index + 1 %>. <%= item.question %></p>

      <% item.options.forEach(option => { %>
        <div class="pl-4">
          <span class="<%= option === item.correctAnswer ? 'text-green-600 font-bold' : '' %>">
            <input type="radio" disabled <%= option === item.userAnswer ? "checked" : '' %> >
            <%= option %>
            <% if (option === item.userAnswer && !item.isCorrect) { %>
              <span class="text-red-600 font-semibold"> (Your Answer)</span>
            <% } %>
            <% if (option === item.correctAnswer && !item.isCorrect) { %>
              <span class="text-green-600 font-semibold"> (Correct Answer)</span>
            <% } %>
          </span>
        </div>
      <% }) %>
    </div>
  <% }) %>
</div>

<div class="flex justify-center mt-6">
  <a href="/" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Try Another Quiz</a>
</div>

</div></body></html>
