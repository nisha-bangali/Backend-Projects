<%- include('partials/header') %>

<h1 class="text-2xl font-semibold mb-6 capitalize"><%= topic %> Quiz</h1>
<form action="/submit/<%= topic %>" method="POST" class="space-y-6">
  <% questions.forEach((q, index) => { %>
    <div class="bg-white p-4 rounded shadow">
      <p class="font-medium mb-2">Q<%= index + 1 %>. <%= q.question %></p>
      <div class="space-y-2">
        <% q.options.forEach(option => { %>
          <label class="block">
            <input type="radio" name="q<%= index %>" value="<%= option %>" required class="mr-2">
            <%= option %>
          </label>
        <% }) %>
      </div>
    </div>
  <% }) %>

  <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">
    Submit
  </button>
</form>

</div></body></html>
