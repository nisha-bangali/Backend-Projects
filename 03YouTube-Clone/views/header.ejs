<header class="bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Left: Logo -->
      <div class="flex-shrink-0 flex items-center space-x-2">
        <i class="fa-brands fa-youtube fa-lg" style="color: #f70808;"></i>
        <span class="text-lg font-bold text-red-600">YouTube Clone</span>
      </div>

      <!-- Center: Search Bar -->
      <div class="hidden md:flex flex-grow justify-center px-4">
        <form action="/search" method="GET" class="w-full max-w-md flex">
          <input
            type="text"
            name="q"
            placeholder="Search"
            class="w-full px-4 py-1 border border-gray-300 rounded-l-full focus:outline-none focus:ring-2 focus:ring-red-500"
          />
          <button type="submit" class="px-4 bg-gray-100 border border-gray-300 rounded-r-full hover:bg-gray-200">
            🔍
          </button>
        </form>
      </div>

      <!-- Right: User Controls -->
      <div class="flex items-center space-x-4">
        <button class="hidden md:inline-block bg-red-600 text-white px-4 py-1 rounded hover:bg-red-700 text-sm"><a href="/upload">Upload</a></button>
       <i class="fa-solid fa-circle-user fa-xl "></i>
      </div>
    </div>
  </div>
</header>
