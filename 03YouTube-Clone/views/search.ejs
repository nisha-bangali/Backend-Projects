<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Search: "<%= searchQuery %>" - YouTube Clone</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">

  <!-- Navbar (optional include) -->
  <%- include('header') %>

  <main class="max-w-6xl mx-auto px-4 py-6">
    <h2 class="text-xl font-semibold mb-4">Search results for "<%= searchQuery %>"</h2>

    <% if (search.length > 0) { %>
      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
        <% search.forEach(video => { %>
          <div class="bg-white rounded shadow hover:shadow-md transition overflow-hidden">
            <a href="/watch?v=<%= video.id %>" class="block relative">
              <img src="<%= video.thumbnailUrl %>" alt="<%= video.title %>" class="w-full h-48 object-cover">
              <span class="absolute bottom-2 right-2 bg-black bg-opacity-70 text-white text-xs px-2 py-1 rounded">
                <%= video.duration %>
              </span>
            </a>
            <div class="p-3">
              <h3 class="font-medium text-md mb-1"><%= video.title %></h3>
              <p class="text-sm text-gray-600">
                <%= video.author %> • <%= video.views %> views • <%= video.uploadTime %>
              </p>
              <p class="text-sm mt-2 text-gray-700 line-clamp-2"><%= video.description %></p>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-gray-600 text-lg">No results found for "<%= searchQuery %>".</p>
    <% } %>
  </main>
</body>
</html>
