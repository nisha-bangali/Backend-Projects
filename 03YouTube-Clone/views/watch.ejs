<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= video.title %> - YouTube Clone</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-900">

  <!-- Navbar -->
  <%- include('header') %>

  <main class="max-w-6xl mx-auto p-4">
    <!-- Video Player -->
    <div class="aspect-w-16 aspect-h-9 w-full mb-4">
      <video controls autoplay muted class="w-full h-auto rounded-md">
        <source src="<%= video.videoUrl %>" type="video/mp4">
        Your browser does not support the video tag.
      </video>
    </div>

    <!-- Title -->
    <h1 class="text-2xl font-semibold mb-2"><%= video.title %></h1>

    <!-- Stats + Actions -->
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center text-sm text-gray-600 mb-4">
      <div><%= video.views %> views • <%= video.uploadTime %></div>
      <div class="flex items-center gap-4 mt-2 sm:mt-0">
        <button class="hover:text-gray-800">👍 Like</button>
        <button class="hover:text-gray-800">👎 Dislike</button>
        <button class="hover:text-gray-800">🔗 Share</button>
      </div>
    </div>

    <!-- Author and Subscribe -->
    <div class="flex items-start gap-4 border-t border-gray-300 pt-4 pb-6">
      <img src="https://i.pravatar.cc/48" alt="Author" class="w-12 h-12 rounded-full">
      <div class="flex-1">
        <div class="flex justify-between items-center">
          <div>
            <h3 class="font-semibold"><%= video.author %></h3>
            <p class="text-sm text-gray-500"><%= video.subscriber %> subscribers</p>
          </div>
          <button class="bg-red-600 text-white px-4 py-1 rounded hover:bg-red-700 text-sm">Subscribe</button>
        </div>
        <!-- Description -->
        <p class="text-sm mt-3 text-gray-700 whitespace-pre-line"><%= video.description %></p>
      </div>
    </div>
  </main>
</body>
</html>
