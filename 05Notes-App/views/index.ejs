<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Notes App</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800 font-sans p-6">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-4">
      Notes <% if (filterTag) { %> - Filtered by: <span class="text-blue-600"><%= filterTag %></span> <% } %>
    </h1>
    <a href="/add" class="inline-block mb-6 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition">+ Add Note</a>
    
    <ul class="space-y-6">
      <% notes.forEach(note => { %>
        <li class="bg-white shadow-md rounded p-4">
          <h3 class="text-xl font-semibold mb-2"><%= note.title %></h3>
          <p class="mb-2"><%= note.body %></p>
          <p class="text-sm text-gray-600">
            Tags:
            <% note.tags.forEach(tag => { %>
              <a href="/?tag=<%= tag %>" class="text-blue-500 hover:underline mr-2">#<%= tag %></a>
            <% }) %>
          </p>
        </li>
      <% }) %>
    </ul>
  </div>
</body>
</html>
